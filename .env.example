# Optional: refine template prompts with a small LLM (OpenAI-compatible Chat Completions API).
# If VITE_LLM_BASE_URL is unset, the app uses templates only (no LLM).
#
# Ollama (local): https://ollama.com — then e.g.
#   ollama pull llama3.2
#   (Ollama listens on http://127.0.0.1:11434 — OpenAI-compatible path is /v1)
VITE_LLM_BASE_URL=http://127.0.0.1:11434/v1
VITE_LLM_MODEL=llama3.2
# VITE_LLM_API_KEY=

# Note: any key set here is visible in the browser bundle. For production secrets, use a backend proxy.
